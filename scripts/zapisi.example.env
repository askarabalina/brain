# Настройки для scripts/zabrat_zapisi.py
#
# Скопировать в ~/.brain-private/zapisi.env и заполнить:
#   mkdir -p ~/.brain-private
#   cp scripts/zapisi.example.env ~/.brain-private/zapisi.env
#   chmod 600 ~/.brain-private/zapisi.env
#
# Вне репозитория намеренно: тут токен бота. Скрипт откажется работать,
# если у файла права шире 600.

# Сервер с ботом: пользователь@адрес. Нужен вход по ключу, без пароля.
SERVER=ubuntu@АДРЕС

# Тот же токен, что в /etc/nanobot.env на сервере — им отправляется ответ.
BOT_TOKEN=

# Твой Telegram ID, тот же TELEGRAM_USER_ID.
CHAT_ID=

# Короче этого — считаем голосовой заметкой, а не встречей, и не трогаем.
MIN_MINUTES=3

# Модель распознавания. На 16 ГБ памяти и больше — large-v3-turbo,
# на 8 ГБ лучше small или medium.
MODEL=large-v3-turbo

# Токен Hugging Face для разделения по говорящим. Можно не указывать,
# если он уже прописан через huggingface-cli login.
HF_TOKEN=

# Куда складывать записи и расшифровки.
ZAPISI_DIR=~/Записи

# Полный путь к whispermlx. Нужен, потому что у запуска по расписанию
# урезанный PATH и команда по имени не находится.
# Посмотреть свой: which whispermlx
WHISPERMLX=
