#!/bin/bash
# Двойной клик в Finder — расшифровать то, что лежит в папке «расшифровать»,
# и забрать записи, присланные боту. Чтобы не ждать расписание.
cd "$(dirname "$0")" || exit 1
echo "Смотрю, что появилось…"
/usr/bin/python3 zabrat_zapisi.py
status=$?
echo
if [ $status -eq 0 ]; then
  echo "Готово. Окно можно закрыть."
else
  echo "Что-то пошло не так, код $status. Покажи это сообщение."
fi
